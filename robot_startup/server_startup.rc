#launch file
ros2 launch rosbridge_server rosbridge_websocket_launch.xml &
ros2 launch higher_layer_mvibot tf2_web_republisher_launch.py &
ros2 launch higher_layer_mvibot mvibot_map_saver_launch.py &
if [[ "$mode" = "navigation" ]]
then
   echo robot run navigation
   ros2 launch higher_layer_mvibot mvibot_map_server_launch.py &
else
   echo robot run slam
   ros2 launch higher_layer_mvibot mvibot_slam_toolbox_launch.py &
fi
ros2 launch higher_layer_mvibot mvibot_server_launch.py &
