[Unit]
Description=floor cleaning robot startup script
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mvibot
Environment="ROS_DOMAIN_ID=11"
Environment="RMW_IMPLEMENTATION=rmw_fastrtps_cpp"
WorkingDirectory=/home/mvibot/floorCleaningRobot_ws
ExecStart=/bin/bash /home/mvibot/floorCleaningRobot_ws/robot_startup/server_startup.rc
Restart=on-failure
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target